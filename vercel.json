{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.appliedquantitativereasoning.com"
        }
      ],
      "destination": "https://appliedquantitativereasoning.com/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self' 'sha256-g5mfgyxTYISeqOh5m06wT7XZeeDFKF3dvArActr0GQ0=' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://challenges.cloudflare.com; font-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-report"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff|woff2)$",
      "headers": {
        "cache-control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(why-aqr|why-ai|course-overview|student-guide|vocabulary(?:/(core|quarter-[1-4]))?|quarter-[1-4]|resources|contact)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/classroom-posters(?:/(all|aqr-identity|qr-questions|data-anti-bs|decision-model|ai-tool-use|pass-path-work-habits|thinking-moves|quotation-posters))?/?$",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
