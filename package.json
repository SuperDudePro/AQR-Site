{
  "name": "aqr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:redirects && npm run validate:sitemap && npm run deployment:marker && tsc -b && vite build && npm run prerender && npm run validate:site && npm run validate:discovery",
    "prerender": "TSX_TSCONFIG_PATH=./tsconfig.app.json node --import tsx scripts/prerender-runner.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "preview": "vite preview",
    "sitemap": "node --import tsx scripts/generate-sitemap.mjs",
    "deployment:marker": "node scripts/write-deployment-marker.mjs",
    "sync:redirects": "node scripts/sync-redirects.mjs",
    "validate:redirects": "node scripts/validate-redirects.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "validate:sitemap": "node scripts/validate-discovery.mjs https://appliedquantitativereasoning.com --sitemap scripts/generate-sitemap.mjs",
    "validate:discovery": "node scripts/validate-discovery.mjs https://appliedquantitativereasoning.com --built",
    "audit:quality": "node scripts/quality-audit.mjs --check",
    "baseline:quality": "node scripts/quality-audit.mjs --record"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.2.2"
  }
}
